# Port for the Node.js Express server to listen on
PORT=5000

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase URL (from Settings -> API in Supabase dashboard)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (from Settings -> API)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Secret Key (from Settings -> API, backend only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

